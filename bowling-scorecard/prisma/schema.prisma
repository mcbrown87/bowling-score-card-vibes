generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  image        String?
  role         UserRole @default(USER)
  emailVerified DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  accounts Account[]
  sessions Session[]
  storedImages StoredImage[]
  players Player[]
  bowlingTeams BowlingTeam[]

  @@map("users")
}

model BowlingTeam {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  storedImages StoredImage[]
  rosterPlayerStatuses TeamRosterPlayerStatus[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("bowling_teams")
}

model Player {
  id             String   @id @default(cuid())
  userId         String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores BowlingScore[]
  teamRosterStatuses TeamRosterPlayerStatus[]

  @@unique([userId, normalizedName])
  @@index([userId])
  @@map("players")
}

model TeamRosterPlayerStatus {
  id         String   @id @default(cuid())
  teamId     String
  playerId   String
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  team BowlingTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId])
  @@map("team_roster_player_statuses")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text @map("refresh_token")
  accessToken       String? @db.Text @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @db.Text @map("id_token")
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model StoredImage {
  id               String   @id @default(cuid())
  userId           String
  teamId           String?
  bucket           String
  objectKey        String
  originalFileName String?
  contentType      String?
  sizeBytes        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team BowlingTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  scores BowlingScore[]
  llmRequests LLMRequest[]

  @@unique([bucket, objectKey])
  @@index([userId])
  @@index([teamId])
  @@map("stored_images")
}

model BowlingScore {
  id            String   @id @default(cuid())
  storedImageId String
  llmRequestId  String?
  playerId      String?
  gameIndex     Int
  playerName    String?
  totalScore    Int?
  frames        Json
  tenthFrame    Json?
  provider      String?
  isEstimate    Boolean  @default(true)
  rawText       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  storedImage StoredImage @relation(fields: [storedImageId], references: [id], onDelete: Cascade)
  llmRequest LLMRequest? @relation(fields: [llmRequestId], references: [id], onDelete: SetNull)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([storedImageId])
  @@index([llmRequestId])
  @@index([playerId])
  @@unique([storedImageId, gameIndex, isEstimate])
  @@map("bowling_scores")
}

model LLMRequest {
  id             String   @id @default(cuid())
  storedImageId  String
  promptId       String
  provider       String
  model          String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?
  status         String
  errorMessage   String?
  rawRequest     Json?
  rawResponse    Json?
  rawText        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  storedImage StoredImage @relation(fields: [storedImageId], references: [id], onDelete: Cascade)
  prompt    Prompt     @relation(fields: [promptId], references: [id], onDelete: Restrict)
  scores      BowlingScore[]

  @@index([storedImageId])
  @@index([promptId])
  @@map("llm_requests")
}

model Prompt {
  id        String   @id @default(cuid())
  version   String   @unique
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  llmRequests LLMRequest[]

  @@map("prompts")
}

model AppConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_config")
}

model ModelArtifact {
  id                     String        @id @default(cuid())
  name                   String
  version                String
  architecture           String
  storageBucket          String?
  storageObjectKey       String?
  localPath              String?
  datasetImageCount      Int?
  datasetCorrectionCount Int?
  metrics                Json?
  isActive               Boolean       @default(false)
  activatedAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt

  @@index([isActive])
  @@unique([name, version])
  @@map("model_artifacts")
}
